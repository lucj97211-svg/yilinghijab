{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "yilinghijab.com" }],
      "destination": "https://www.yilinghijab.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|robots.txt|sitemap.xml|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
